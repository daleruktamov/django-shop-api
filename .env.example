# Скопируйте этот файл в .env и подставьте свои значения.

SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Если переменную не задать, проект поднимется на локальном SQLite.
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# Время жизни JWT-токенов
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# CORS: во время разработки проще разрешить всех
CORS_ALLOW_ALL_ORIGINS=True
